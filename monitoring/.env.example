# このファイルを .env という名前でコピーして、値を書き換える（cp .env.example .env）。
# .env は GitHub に上げない（.gitignore に入っている）。

# ---- 自分で決める合言葉（好きな文字列。長いほうがよい） ----
# Zabbix のデータベース用。一度起動したあとは変えない
ZABBIX_DB_PASSWORD=change-me-db
# Grafana の画面に admin で入るときのパスワード（初回の起動時にだけ使われる）
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# ---- Grafana が Zabbix を読むための利用者 ----
# 最初は Admin / zabbix。Zabbix の画面でパスワードを変えたら、ここも同じ値に変えて
# docker compose up -d を実行し直す
ZABBIX_API_USER=Admin
ZABBIX_API_PASSWORD=zabbix

# ---- Grafana Cloud の Loki（記録を「読む」ための設定） ----
# URL は https://logs-prod-XXX.grafana.net の形（末尾に /loki/api/v1/push は付けない）
LOKI_URL=
# 数字の番号（User）
LOKI_USER=
# 読み取り用のトークン（logs:read）。Render に入れた書き込み用とは別のもの
LOKI_READ_TOKEN=

# 画面に出す時刻の地域
TZ=Asia/Tokyo
